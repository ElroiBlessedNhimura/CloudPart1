{
  "info": {
    "name": "CoffeeNChill - Lehlohonolo Documents",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:7071"
    },
    {
      "key": "uploadedFileName",
      "value": "sample-recipe.txt"
    }
  ],
  "item": [
    {
      "name": "Documents",
      "item": [
        {
          "name": "Upload Staff Document",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": "SELECT_SAMPLE_FILE_IN_POSTMAN"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/documents/upload",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "documents",
                "upload"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test(\"Response contains document details\", function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.fileName).to.be.a(\"string\").and.not.empty;",
                  "    pm.expect(jsonData.size).to.be.above(0);",
                  "    pm.expect(jsonData.lastModified).to.exist;",
                  "    pm.expect(jsonData.contentType).to.be.a(\"string\").and.not.empty;",
                  "});",
                  "",
                  "if (pm.response.code === 201) {",
                  "    const jsonData = pm.response.json();",
                  "    pm.collectionVariables.set(\"uploadedFileName\", jsonData.fileName);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "List Staff Documents",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/documents",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "documents"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response is a document list\", function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.be.an(\"array\");",
                  "});",
                  "",
                  "pm.test(\"Uploaded document appears in the list\", function () {",
                  "    const jsonData = pm.response.json();",
                  "    const fileName = pm.collectionVariables.get(\"uploadedFileName\");",
                  "    pm.expect(jsonData.some(item => item.fileName === fileName)).to.eql(true);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Download Staff Document",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/documents/download/{{uploadedFileName}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "documents",
                "download",
                "{{uploadedFileName}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Downloaded file has content\", function () {",
                  "    pm.expect(pm.response.text().length).to.be.above(0);",
                  "});",
                  "",
                  "pm.test(\"Content-Type is returned\", function () {",
                  "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.exist;",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Reject Unsupported Staff Document",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": "SELECT_UNSUPPORTED_FILE_IN_POSTMAN"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/documents/upload",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "documents",
                "upload"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 400\", function () {",
                  "    pm.response.to.have.status(400);",
                  "});",
                  "",
                  "pm.test(\"Response contains a validation error\", function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.error).to.be.a(\"string\").and.not.empty;",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Download Missing Staff Document",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/documents/download/file-that-does-not-exist.pdf",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "documents",
                "download",
                "file-that-does-not-exist.pdf"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 404\", function () {",
                  "    pm.response.to.have.status(404);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
