        {
          "name": "Get Menu By Category",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {\r",
                  "    pm.response.to.have.status(200);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Response time is under 2000ms\", function () {\r",
                  "    pm.expect(pm.response.responseTime).to.be.below(2000);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Response is an array\", function () {\r",
                  "    const data = pm.response.json();\r",
                  "    pm.expect(data).to.be.an(\"array\");\r",
                  "});\r",
                  "\r",
                  "pm.test(\"All items belong to the requested category\", function () {\r",
                  "    const data = pm.response.json();\r",
                  "    data.forEach(item => {\r",
                  "        pm.expect(item.category).to.eql(\"Hot Drinks\");\r",
                  "    });\r",
                  "});\r",
                  "\r",
                  "pm.test(\"If items exist, they have all required fields\", function () {\r",
                  "    const data = pm.response.json();\r",
                  "    if (data.length > 0) {\r",
                  "        data.forEach(item => {\r",
                  "            pm.expect(item).to.have.property(\"category\");\r",
                  "            pm.expect(item).to.have.property(\"id\");\r",
                  "            pm.expect(item).to.have.property(\"name\");\r",
                  "            pm.expect(item).to.have.property(\"price\");\r",
                  "            pm.expect(item).to.have.property(\"isAvailable\");\r",
                  "        });\r",
                  "    }\r",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
